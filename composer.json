{
    "name": "inid/inid",
    "description": "Sign-in with InID for PHP and Laravel: the sign-in routes, a fresh session, paths protected by role or permission, webhooks and the app API.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://inid.co/docs/frameworks/",
    "keywords": ["inid", "auth", "authentication", "sign-in", "oidc", "openid-connect", "passkeys", "laravel"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "orchestra/testbench": "^10.0",
        "nyholm/psr7": "^1.8",
        "psr/simple-cache": "^3.0"
    },
    "suggest": {
        "laravel/framework": "For the Laravel integration (InID\\Laravel), auto-discovered",
        "psr/simple-cache": "To share InID's public keys across requests (PSR-16 cache)",
        "psr/http-message": "To convert requests and responses from and to PSR-7",
        "ext-curl": "Used for requests to InID when available (streams otherwise)"
    },
    "autoload": {
        "psr-4": { "InID\\": "src/" },
        "files": ["src/Laravel/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "InID\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["InID\\Laravel\\InIDServiceProvider"],
            "aliases": { "InID": "InID\\Laravel\\Facades\\InID" }
        }
    },
    "config": {
        "sort-packages": true,
        "platform": { "php": "8.2.0" }
    },
    "minimum-stability": "stable"
}
